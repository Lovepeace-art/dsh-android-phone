{
  "name": "dsh-android-phone",
  "version": "1.0.0",
  "description": "DSH 侧栏里的安卓真机：scrcpy 实时画面 + 亚毫秒控制通道 + 截屏/长截图，并把手机操作能力作为工具交给模型",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "actions",
    "scripts/install.ps1",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "author": "feiniao",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "scrcpy",
    "adb",
    "screenshot",
    "long-screenshot",
    "phone-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lovepeace-art/dsh-android-phone.git"
  },
  "homepage": "https://github.com/Lovepeace-art/dsh-android-phone#readme",
  "bugs": {
    "url": "https://github.com/Lovepeace-art/dsh-android-phone/issues"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/test-stitch.mjs && node test/test-client.mjs",
    "test:offline": "node test/test-stitch.mjs && node test/test-client.mjs",
    "test:device": "node test/test-plugin-tools.mjs && node test/test-session.mjs && node test/test-host.mjs && node test/test-e2e-jd.mjs",
    "install:profile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:profile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1 -Uninstall"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "dsh-better-sidebar": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
