{
  "name": "dsh-android-phone",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 侧栏里的安卓真机：scrcpy 实时画面 + 控制通道（亚毫秒点按/滑动/中文输入）+ 截屏/长截图，并把手机操作能力作为工具交给模型",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "actions",
    "scripts",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "dsh-better-sidebar": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node scripts/test-plugin-tools.mjs && node scripts/test-stitch.mjs && node scripts/test-client.mjs && node scripts/test-host.mjs --no-device",
    "test:device": "node scripts/test-session.mjs",
    "test:e2e": "node scripts/test-e2e-jd.mjs",
    "serve": "node scripts/serve-api.mjs"
  }
}
